# --- Stripe (optional) ---
# Without this, checkout runs in demo mode (no real charge).
# With a test key from https://dashboard.stripe.com/test/apikeys, buyers pay
# on Stripe's secure hosted page. Test card: 4242 4242 4242 4242
STRIPE_SECRET_KEY=

# Public URL of the frontend (used for Stripe redirect after payment)
FRONTEND_URL=http://localhost:5173

# --- App ---
# Used to sign login tokens — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
